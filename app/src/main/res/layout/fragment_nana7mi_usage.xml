<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/six_dp"
        android:fitsSystemWindows="true"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:navigationIcon="@drawable/ic_arrow_back_white_shadow"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:title=" "
        app:titleTextColor="@android:color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/nana7mi_usage_title"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            下拉刷新裹在内容外面而不是整个 FrameLayout 外面：加载态和错误态各有各的
            交互（转圈不该能下拉，错误态整块点一下就是重试），套进来只会多出两条
            「同一件事有两种做法」的路径。
        -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/content_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="32dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <!--
                        Claude 用量页顶上那句「Plan usage limits  Max (5x)」的位置：左边说明
                        额度是按谁算的，右边挂当前档位和倍率。

                        档位就挂在标题旁边、进度条正上方，而不是塞进下面的订阅区 —— 那两根条
                        画的就是这一档的额度，读数和它的量纲必须挨在一起；隔着半屏去猜「这条
                        100% 是几次的 100%」正是这页原来缺的那句话。
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp"
                        android:paddingStart="4dp">

                        <TextView
                            android:id="@+id/usage_section_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nana7mi_usage_section"
                            android:textColor="@color/v3_text_2"
                            android:textSize="13sp" />

                        <!--
                            「Max (20x)」。用 Montserrat 是因为括号里是读数（倍率），和页面上
                            其它数字读数同一套字；档位名本身是产品名，不翻译。
                            拿不到档位就整个 gone —— 空着一块比写个假的「Free」强。
                        -->
                        <TextView
                            android:id="@+id/usage_plan_label"
                            style="@style/textMontserratBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/v3_text_1"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="Max (20x)"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- 分段行宿主：两只桶各一行，圆角由 WitRowStyle 按位置贴合 -->
                    <LinearLayout
                        android:id="@+id/usage_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!--
                        云翻译额度（服务端 src/translate.js 的两只桶，单位是字符）。和热度排序共用
                        同一档位倍率，所以放在同一页、同一套分段行；服务端说功能关着或老服务端
                        没这条路由时整组 gone，不画一组永远动不了的进度条。
                    -->
                    <TextView
                        android:id="@+id/translate_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="4dp"
                        android:text="@string/cloud_translate_usage_section"
                        android:textColor="@color/v3_text_2"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/translate_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- 失败态整块可点重试：错误页上再放一个小按钮，手指要瞄准，没必要 -->
        <LinearLayout
            android:id="@+id/error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/v3_text_2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/error_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nana7mi_usage_retry"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
